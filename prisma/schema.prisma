// Prisma schema — the source of truth for the data model.
//
// This mirrors src/types/content.ts. When the two disagree, this file wins and
// the TypeScript types should be brought into line, because a migration has
// already been applied to a real database by the time they diverge.
//
// Prisma 7 notes, which differ from most examples written for v6:
//   - Connection URLs live in prisma.config.ts, NOT in the datasource block.
//   - The client generates to src/generated/prisma (gitignored), not into
//     node_modules. `prisma generate` runs as part of `npm run build`.
//   - Queries go through the @prisma/adapter-pg driver adapter; see
//     src/lib/db.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums — kept in exact step with src/types/content.ts
// ---------------------------------------------------------------------------

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum ExperienceKind {
  TECHNICAL
  PROFESSIONAL
  LEADERSHIP
}

enum EngagementType {
  INTERNSHIP
  EMPLOYMENT
  CONTRACT
  // Work found through a marketplace. The platform is recorded separately
  // from the organization so it is never presented as an employer.
  PLATFORM_ENGAGEMENT
  VOLUNTEER
  MEMBERSHIP
}

enum SkillCategory {
  LANGUAGE
  FRAMEWORK
  DATABASE
  TOOL
  PRACTICE
}

enum SocialPlatform {
  GITHUB
  LINKEDIN
  EMAIL
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

/// The site's single administrator.
///
/// There is deliberately no `role` column and no self-service creation path:
/// rows are inserted only by scripts/create-admin.ts, run locally. No HTTP
/// endpoint anywhere in this codebase creates an AdminUser. That absence is
/// the single most effective security control available here, and it is free.
///
/// No session table — the JWT strategy keeps session state in a signed cookie,
/// which is appropriate for exactly one user. See docs/decisions/0003.
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  /// argon2id. Never a plaintext or reversibly-encoded password.
  passwordHash String
  name         String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// One row per FAILED sign-in attempt, and the whole basis of the login rate
/// limit. Phase 7 shipped without one and recorded the gap: nothing stopped
/// thousands of password guesses.
///
/// Only failures are stored, and a successful sign-in DELETES the rows for
/// that address — so someone who mistypes their password four times and then
/// gets it right is not left one attempt away from being locked out.
///
/// Rows are pruned as they age out of the window, by the same code that
/// writes them. No cron job and no scheduled function: failed logins are the
/// only thing that inserts here, so the cheapest place to clean up is on the
/// way in, and the table stays small enough that the indexes below are
/// almost decorative.
///
/// There is no `email` column, on purpose. Storing which address was
/// attempted would turn this table into a log of guessed usernames — a thing
/// worth stealing — and the limit does not need it: with exactly one
/// administrator, "how many failures from this address recently" is the only
/// question being asked.
model LoginAttempt {
  id String @id @default(cuid())

  /// SHA-256 of the client IP with a domain-separated secret, never the raw
  /// address — the same treatment as ContactMessage.ipHash, for the same
  /// reasons. Null when no address could be read from the request.
  ipHash String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  /// Serves the limit lookup: recent failures from one address.
  @@index([ipHash, createdAt])
}

// ---------------------------------------------------------------------------
// Content
//
// Dates that describe periods (a project's completion, a role's start) are
// stored as "YYYY" or "YYYY-MM" strings rather than DateTime. They are not
// instants: coercing "2025-11" to a timestamp invents a day and a timezone,
// and reading it back in a negative offset rolls it to October. Row
// timestamps, which ARE instants, use DateTime.
// ---------------------------------------------------------------------------

/// Singleton. Exactly one row, addressed by a fixed id.
model Profile {
  id           String   @id @default("singleton")
  name         String
  headline     String
  shortBio     String
  longBio      String[]
  location     String
  email        String
  availability String?

  /// Portrait shown in the home page hero. Null is a supported state — the
  /// hero renders as a single text column without it, exactly as it did
  /// before Phase 9a.
  ///
  /// No `alt` column on purpose: the alt text for a portrait is the person's
  /// name, which is the row above. A field that can only sensibly hold one
  /// value is a field that will eventually hold the wrong one.
  photoUrl      String?
  /// Path within the Blob store, so replacing the photo can delete the old
  /// file. Null when no photo has been uploaded. See ProjectImage.
  photoPathname String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  description String
  role        String?
  featured    Boolean  @default(false)
  startedAt   String?
  completedAt String?
  /// Display names. Deliberately not a Tag relation — see docs/content-model.md.
  tech        String[]
  repoUrl     String?
  liveUrl     String?
  outcomes    String[]
  challenges  String[]

  status    PublishStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  images ProjectImage[]

  @@index([status, sortOrder])
}

/// A screenshot or diagram belonging to a project.
///
/// The one content model WITHOUT a `status` column, which is a deliberate
/// exception to the rule in CLAUDE.md. An image is not independently
/// publishable: its visibility is its project's, and a second publish axis
/// would mean a published project could silently render nothing while every
/// image sat in draft. To take an image off the site, delete it or reorder it.
///
/// `alt` is a required column rather than an optional one. Alt text that can
/// be skipped is alt text that is skipped, and these images carry the actual
/// content of a project page. Decorative images are not a case this model
/// needs to serve.
model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  url String
  /// The path within the Blob store. Kept so the file can be deleted, and so
  /// an orphan can be matched back to the row that owned it.
  pathname String
  alt      String
  caption  String?
  /// Intrinsic dimensions, read from the file header at upload. Nullable
  /// because parsing is best effort — see readImageDimensions in
  /// src/lib/storage.ts. Used to reserve space and avoid layout shift.
  width  Int?
  height Int?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, sortOrder])
}

model Experience {
  id             String         @id @default(cuid())
  slug           String         @unique
  kind           ExperienceKind
  engagementType EngagementType
  title          String
  /// The actual employer, client, or organization. Null for independent work.
  organization   String?
  /// e.g. "Taskrabbit" — rendered as "via Taskrabbit", never as an employer.
  platform       String?
  location       String?
  startDate      String
  endDate        String?
  current        Boolean        @default(false)
  summary        String
  highlights     String[]
  skills         String[]

  status    PublishStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, kind, sortOrder])
}

model Education {
  id          String   @id @default(cuid())
  slug        String   @unique
  institution String
  degree      String
  field       String
  location    String?
  startDate   String
  endDate     String?
  expected    Boolean  @default(false)
  highlights  String[]

  status    PublishStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, sortOrder])
}

model Skill {
  id       String        @id @default(cuid())
  name     String        @unique
  category SkillCategory

  status    PublishStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, category, sortOrder])
}

model SocialLink {
  id       String         @id @default(cuid())
  platform SocialPlatform @unique
  label    String
  url      String

  status    PublishStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

/// A service offered directly to clients — Phase 12.
///
/// Deliberately separate from Experience, which describes the same Taskrabbit
/// work. An Experience row is a record addressed to recruiters; a Service is
/// an offer addressed to someone deciding whether to hire him. Merging them
/// would mean one audience's page changing to suit the other's reader.
///
/// There is no `price` column, and that is a decision rather than an omission.
/// Rates are quoted per task on the platform and change; a number stored here
/// would end up printed on a public page as a promise nobody remembers making.
/// `pricingNote` is free text for describing how pricing works.
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  summary     String
  description String
  includes    String[]
  serviceArea String?
  pricingNote String?

  status    PublishStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, sortOrder])
}

/// An outbound referral destination — Phase 12.
///
/// Every outbound Taskrabbit link in the application points at `/r/[slug]`,
/// never at `url` directly. That indirection is why adding click tracking
/// later is one insert in one file instead of an audit of every page for the
/// links somebody forgot. The seam was cut early on purpose; see
/// docs/architecture.md.
///
/// `promoCode` lives here for the same reason the URL does: a promo code
/// hard-coded into a component is a promo code that expires and needs a
/// developer.
model ReferralLink {
  id          String  @id @default(cuid())
  slug        String  @unique
  label       String
  url         String
  promoCode   String?
  description String?

  status    PublishStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, sortOrder])
}

/// A message sent through the public contact form.
///
/// NOT a content model, which is why it has no `status` or `sortOrder`
/// despite the rule in CLAUDE.md. Nothing here is ever published; this is an
/// inbox, and the only state a message has is whether it has been read.
///
/// **This table is the system of record, not the email.** The notification to
/// Bidipta is a convenience layered on top: if Resend is misconfigured, over
/// quota, or down, the row is still written and the message is still readable
/// at /admin/messages. A contact form that loses messages when a third party
/// has a bad day is worse than no contact form, because the sender believes
/// they were heard.
model ContactMessage {
  id      String  @id @default(cuid())
  name    String
  email   String
  subject String?
  message String

  /// SHA-256 of the sender's IP with a domain-separated secret — never the
  /// raw address. Enough to rate-limit and to recognise a repeat flooder,
  /// not enough to identify or track anyone. See src/server/rate-limit.ts.
  ipHash    String?
  userAgent String?

  read Boolean @default(false)
  /// When the notification email was accepted by the provider. Null means it
  /// was never sent — an unconfigured key, a failure, or a send still in
  /// flight. The admin inbox surfaces this, so a silent email failure cannot
  /// masquerade as "no one has written to me".
  notifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([createdAt])
  /// Serves the rate-limit lookup: recent messages from one sender.
  @@index([ipHash, createdAt])
}

model ResumeVersion {
  id           String  @id @default(cuid())
  label        String
  fileUrl      String
  /// The URL that forces a save-to-disk instead of opening in the browser.
  ///
  /// Needed because `<a download>` is IGNORED cross-origin: once the file
  /// lives on a Blob domain rather than under /public, the download button
  /// silently becomes an "open in this tab" button. Vercel Blob serves this
  /// variant with `content-disposition: attachment`.
  ///
  /// Null for a file still served from /public, where `download` works.
  downloadUrl  String?
  /// The path within the Blob store; null for a /public file. See ProjectImage.
  pathname     String?
  downloadName String
  /// The month the resume itself was revised — not the row timestamp.
  revisedAt    String
  isCurrent    Boolean @default(false)

  status    PublishStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
