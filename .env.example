# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored. This file is committed and must never contain secrets.
#
# Every variable the application reads should be listed here, even if optional.
# Keep it current: an out-of-date .env.example is worse than none.

# ---------------------------------------------------------------------------
# ACTIVE
# ---------------------------------------------------------------------------

# Canonical public origin, no trailing slash.
# Used for absolute URLs in metadata, Open Graph tags, sitemap.xml and robots.txt.
# Local:      http://localhost:3000
# Production: https://portfolio-ten-theta-d09qbq67e8.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# NOT YET USED — added in later phases. Listed so the full surface is visible.
# Nothing reads these today; do not set them yet.
# ---------------------------------------------------------------------------

# Phase 6 — Database (Neon Postgres)
#   DATABASE_URL is the POOLED connection string (used at runtime by Prisma).
#   DIRECT_URL is the direct, unpooled string (used by `prisma migrate`).
#   Using the pooled URL for migrations, or the direct URL at runtime, will
#   cause connection-limit failures on serverless. See docs/decisions/0002.
# DATABASE_URL=
# DIRECT_URL=

# Phase 7 — Authentication (Auth.js v5)
#   Generate a secret with: npx auth secret
# AUTH_SECRET=
# AUTH_URL=

# Phase 9 — Transactional email (Resend) and file storage (Vercel Blob)
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# BLOB_READ_WRITE_TOKEN=
